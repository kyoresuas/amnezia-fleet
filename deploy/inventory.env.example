# Скопируйте в deploy/inventory.env и заполните
# Паролей здесь нет: bootstrap.sh спросит их один раз и разложит SSH-ключ

SSH_USER=root

# Control plane: fleetd, PostgreSQL, ClickHouse
CONTROL_HOST=
API_DOMAIN=fleet.example.com

# Cloudflare для автопереключения DNS, токен с правом Zone.DNS:Edit; пусто, если DNS меняете вручную
CF_API_TOKEN=
CF_ZONE_ID=

# Проба в РФ (можно тот же хост, что и control plane)
PROBE_HOST=

# Кластер и домен, который попадёт в конфиги клиентов
CLUSTER_NAME=main
VPN_DOMAIN=vpn.example.com

# Выход для YouTube через РФ: сервер в российском дата-центре, пусто если не нужен
EXIT_HOST=
EXIT_NAME=ru

# Узлы VPN: имя, адрес для SSH, публичные IP через запятую (первый активный, остальные запасные)
NODES=(
  "nl-1 203.0.113.10 203.0.113.10"
  "nl-2 203.0.113.20 203.0.113.20,203.0.113.21"
)
